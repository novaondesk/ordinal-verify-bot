# Copy to .env and fill in.

# Required: Discord bot token from https://discord.com/developers/applications
DISCORD_TOKEN=your_discord_bot_token_here

# Optional: restrict slash-command sync to a single guild for instant updates during dev.
# Leave at 0 to register globally (can take up to ~1 hour to propagate).
GUILD_ID=0

# Optional: role to grant on successful verification. Bot must have "Manage Roles"
# and the role must be placed below the bot's own top role.
VERIFIED_ROLE_ID=0

# Optional: Hiro Ordinals API. Public endpoint works without a key but is rate-limited.
# Get a key at https://platform.hiro.so/ to raise limits.
HIRO_API=https://api.hiro.so
HIRO_API_KEY=

# Optional: where to keep the discord_id <-> btc_address binding.
DB_PATH=verifications.db
