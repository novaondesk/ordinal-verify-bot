# Copy to .env and fill in.

# Required: Discord bot token from https://discord.com/developers/applications
DISCORD_TOKEN=your_discord_bot_token_here

# Optional: restrict slash-command sync to a single guild for instant updates during dev.
# Leave at 0 to register globally (can take up to ~1 hour to propagate).
GUILD_ID=0

# Optional: role to grant on successful verification. Bot must have "Manage Roles"
# and the role must be placed below the bot's own top role.
VERIFIED_ROLE_ID=0

# Ordinals lookup via Ordiscan API (Hiro's ordinals API was sunset 2026-03-09).
# An API key is required — without one the bot still verifies ownership but
# always reports 0 inscriptions. Free tier at https://ordiscan.com/docs/api/login .
ORDISCAN_API=https://api.ordiscan.com
ORDISCAN_API_KEY=

# Optional: where to keep the discord_id <-> btc_address binding.
DB_PATH=verifications.db

# Optional: URL of the static "Sign with wallet" page (Sats Connect).
# When set, /verify shows a link button that opens this page with the
# challenge pre-filled, so mobile users don't have to copy the message
# into their wallet manually. Leave blank to omit the button.
SIGN_PAGE_URL=https://novaondesk.github.io/ordinal-verify-bot/sign.html
